# Optional: serve the Next.js app under Apache (XAMPP) instead of opening port 3000 directly.
#
# 1. In C:\xampp\apache\conf\httpd.conf enable:
#      LoadModule proxy_module modules/mod_proxy.so
#      LoadModule proxy_http_module modules/mod_proxy_http.so
#      Include conf/extra/httpd-vhosts.conf
# 2. Copy this file to C:\xampp\apache\conf\extra\ittefaq-pos.conf and add:
#      Include conf/extra/ittefaq-pos.conf
# 3. Start MySQL + run: npm run prod:local  (Node listens on 127.0.0.1:3000)
# 4. Restart Apache in XAMPP
#
# Then open: http://localhost/   OR adjust DocumentAlias below.

<VirtualHost *:80>
    ServerName localhost

    # Proxy all requests to the local Next.js production server
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:3000/
    ProxyPassReverse / http://127.0.0.1:3000/

    # WebSocket (if needed later)
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) ws://127.0.0.1:3000/$1 [P,L]
</VirtualHost>

# Subpath example (app at http://localhost/itefaq/) — Next.js needs basePath in next.config; use root proxy above for simplest test.
