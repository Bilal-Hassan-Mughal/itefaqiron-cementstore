{
  "name": "pos-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev -H 0.0.0.0",
    "dev:matcher": "set \"PATH=C:\\Program Files\\dotnet;%PATH%\"&& dotnet run --project fingerprint-matcher/FingerprintMatcher -c Release",
    "dev:matcher:5051": "set \"PATH=C:\\Program Files\\dotnet;%PATH%\"&& set ASPNETCORE_URLS=http://127.0.0.1:5051&& dotnet run --project fingerprint-matcher/FingerprintMatcher -c Release",
    "dev:5051": "concurrently -n next,matcher -c cyan,magenta \"npm run dev:next\" \"npm run dev:matcher:5051\"",
    "dev:full": "concurrently -n next,matcher -c cyan,magenta \"npm run dev:next\" \"npm run dev:matcher\"",
    "dev": "npm run dev:full",
    "build:matcher": "dotnet publish fingerprint-matcher/FingerprintMatcher -c Release -o fingerprint-matcher/publish",
    "start:matcher": "dotnet fingerprint-matcher/publish/FingerprintMatcher.dll",
    "build": "node scripts/build-nodeafis.js && npx prisma generate && next build --webpack",
    "postinstall": "node scripts/build-nodeafis.js && prisma generate",
    "start": "next start -H 0.0.0.0",
    "app:start": "npm --prefix laravel-pos run app:start",
    "app:dist": "npm --prefix laravel-pos run app:dist",
    "lint": "next lint",
    "db:reset": "prisma db push --force-reset && node prisma/seed-admin.js",
    "db:wipe-transactions": "node scripts/reset-financial-transactions.js",
    "generate": "prisma generate",
    "db:local": "node scripts/prepare-local-db.js",
    "db:local:sync": "node scripts/prepare-local-db.js --sync",
    "db:seed": "node prisma/seed-admin.js && node prisma/seed-master-data.js",
    "db:seed:main": "node scripts/setup-branches.js && node prisma/seed-main-branch-sample.js",
    "db:seed:demo:ledger": "node scripts/seed-demo-ledger.js",
    "repair-day-end": "node scripts/repair-day-end-from-ledger.js",
    "db:seed:transactions": "node scripts/seed-dummy-purchases-sales.js",
    "db:import:main": "node scripts/import-main-branch-from-sql.js --force --sql \"Ittefaqiron (3).sql\"",
    "db:seed:hq": "node prisma/seed-admin.js",
    "db:seed:credentials": "node prisma/seed-credentials.js",
    "db:branches": "node scripts/setup-branches.js",
    "db:branch:migrate": "node scripts/pre-branch-push.js && npx prisma db push && node scripts/setup-branches.js",
    "db:branch:provision": "node scripts/provision-branch-tables.js",
    "db:seed:sales-accounts": "node scripts/seed-sales-accounts.js 10",
    "db:seed:sales-buyers": "node scripts/seed-sales-demo-buyers.js 10",
    "db:seed:demo-products": "node scripts/seed-sales-demo-products.js 10",
    "db:seed:demo-transactions": "node scripts/seed-demo-real-transactions.js"
  },
  "dependencies": {
    "@digitalpersona/core": "^0.2.6",
    "@digitalpersona/devices": "^0.2.6",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.4",
    "@mui/material-nextjs": "^7.3.9",
    "@prisma/client": "^6.17.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.545.0",
    "mysql2": "^3.24.2",
    "next": "^16.0.7",
    "node-fetch": "^3.3.2",
    "nodeafis": "https://github.com/martines205/nodeafis/archive/7a0b873e177058581b903de15060a3b2012123e9.tar.gz",
    "pngjs": "^7.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "typescript": "^5.6.0"
  }
}
