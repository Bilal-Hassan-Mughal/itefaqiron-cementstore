# Database
DATABASE_URL="mysql://user:password@host:3306/database"

# --- XAMPP local test (MySQL in XAMPP Control Panel, import your .sql backup) ---
# DATABASE_URL="mysql://root@127.0.0.1:3306/your_database_name"
# Then: npm run prod:local  →  http://127.0.0.1:3000
# Optional Apache proxy: scripts/xampp/apache-itefaq-proxy.conf.example

# App URL (optional)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Fingerprint — built-in matcher runs inside Vercel (no extra service needed).
# Only set this if you host the legacy .NET matcher separately:
# FINGERPRINT_MATCHER_URL="https://your-matcher-service.example.com"
# FINGERPRINT_MATCHER_API_KEY="your-long-random-secret"

# Optional — match threshold (default 40)
# FINGERPRINT_MIN_SCORE=40
