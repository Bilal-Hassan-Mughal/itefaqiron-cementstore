# Database
DATABASE_URL="mysql://user:password@host:3306/database"

# App URL (optional)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Fingerprint — built-in matcher runs inside Vercel (no extra service needed).
# Only set this if you host the legacy .NET matcher separately:
# FINGERPRINT_MATCHER_URL="https://your-matcher-service.example.com"
# FINGERPRINT_MATCHER_API_KEY="your-long-random-secret"

# Optional — match threshold (default 40)
# FINGERPRINT_MIN_SCORE=40
