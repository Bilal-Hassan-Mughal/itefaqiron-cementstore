  details         String?  @db.Text
  debit_amount    Decimal  @default(0.00) @db.Decimal(12, 2)
  credit_amount   Decimal  @default(0.00) @db.Decimal(12, 2)
  opening_balance Decimal  @default(0.00) @db.Decimal(12, 2)
  closing_balance Decimal  @default(0.00) @db.Decimal(12, 2)
  employee        Employee @relation(fields: [emp_id], references: [emp_id], onDelete: Cascade)

  @@index([emp_id, created_at])
  @@index([branch_id])
  @@map("employee_ledger")
}

model Attendance {
  att_id     Int              @id @default(autoincrement())
  emp_id     Int
  att_date   DateTime         @db.Date
  in_time    String?
  out_time   String?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  employee   Employee         @relation(fields: [emp_id], references: [emp_id], onDelete: Cascade)

  @@unique([emp_id, att_date])
  @@index([emp_id])
  @@index([att_date])
  @@map("attendance")
}

model Payroll {
  payroll_id        Int               @id @default(autoincrement())
  emp_id            Int
  month             Int
  year              Int
  basic_salary      Decimal           @db.Decimal(10, 2)
  total_days        Int               @default(30)
  days_present      Int               @default(0)
  leaves_taken      Int               @default(0)
  absents_taken     Int               @default(0)
  allowed_leaves    Int               @default(0)
  allowed_absents   Int               @default(0)
  excess_leaves     Int               @default(0)
  excess_absents    Int               @default(0)
  deduction_per_day Decimal           @default(0.00) @db.Decimal(10, 2)
  total_deduction   Decimal           @default(0.00) @db.Decimal(10, 2)
  advance_deduction Decimal           @default(0.00) @db.Decimal(10, 2)
  bonus             Decimal           @default(0.00) @db.Decimal(10, 2)
  other_deduction   Decimal           @default(0.00) @db.Decimal(10, 2)
  net_salary        Decimal           @default(0.00) @db.Decimal(10, 2)
  status            PayrollStatus     @default(PENDING)
  payment_date      DateTime?
  notes             String?           @db.Text
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  employee          Employee          @relation(fields: [emp_id], references: [emp_id], onDelete: Cascade)
  advances          EmployeeAdvance[]

  @@unique([emp_id, month, year])
  @@index([emp_id])
  @@map("payrolls")
}

enum AdvanceStatus {
  PENDING
  DEDUCTED
  CANCELLED
}

model EmployeeAdvance {
  advance_id   Int           @id @default(autoincrement())
  emp_id       Int
  amount       Decimal       @db.Decimal(10, 2)
  advance_date DateTime      @db.Date
  payment_mode PaymentType   @default(CASH)
  account_id   Int?
  reason       String?
  status       AdvanceStatus @default(PENDING)
  payroll_id   Int?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  employee     Employee      @relation(fields: [emp_id], references: [emp_id], onDelete: Cascade)
  payroll      Payroll?      @relation(fields: [payroll_id], references: [payroll_id], onDelete: SetNull)

  @@index([emp_id])
  @@index([payroll_id])
  @@map("employee_advances")
}

model HrSettings {
  id                      Int      @id @default(autoincrement())
  branch_id               Int      @default(1)
  allowed_leaves_per_month Int     @default(2)
  allowed_leaves_per_year  Int     @default(24)
  updated_at              DateTime @updatedAt
  branch                  Branch   @relation(fields: [branch_id], references: [branch_id])

  @@index([branch_id], map: "hr_settings_branch_id_fkey")
  @@map("hr_settings")
}

enum EmpStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum PayrollStatus {
