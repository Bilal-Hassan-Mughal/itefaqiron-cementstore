enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Payment {
  payment_id          Int                     @id @default(autoincrement())
  branch_id           Int                     @default(1)
  payment_date        DateTime                @db.Date
  payment_type        PaymentTransactionType
  account_id          Int
  total_amount                  Decimal   @db.Decimal(18, 2)
  discount_amount               Decimal   @default(0.00) @db.Decimal(18, 2)
  net_amount                    Decimal   @db.Decimal(18, 2)
  cash_account_id     Int?
  cash_amount                   Decimal   @default(0.00) @db.Decimal(18, 2)
  bank_account_id     Int?
  bank_amount                   Decimal   @default(0.00) @db.Decimal(18, 2)
  description         String?
  status              PaymentStatus   @default(COMPLETED)
  created_by          Int
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  
  // Relations
  branch              Branch          @relation(fields: [branch_id], references: [branch_id])
  account             Customer        @relation("PaymentAccount", fields: [account_id], references: [cus_id])
  cash_account        Customer?       @relation("PaymentCashAccount", fields: [cash_account_id], references: [cus_id])
  bank_account        Customer?       @relation("PaymentBankAccount", fields: [bank_account_id], references: [cus_id])
  created_by_user     Users           @relation(fields: [created_by], references: [user_id])

  payment_details      PaymentDetail[]

  @@index([branch_id], map: "payments_branch_id_fkey")
  @@index([account_id], map: "payment_account_id_fkey")
  @@index([cash_account_id], map: "payment_cash_account_id_fkey")
  @@index([bank_account_id], map: "payment_bank_account_id_fkey")
  @@index([created_by], map: "payment_created_by_fkey")
  @@map("payments")
}

model PaymentDetail {
  payment_detail_id   Int      @id @default(autoincrement())
  payment_id          Int
  account_id          Int
  amount                        Decimal   @db.Decimal(18, 2)
  description         String?
  created_at          DateTime @default(now())
  
  // Relations
  payment             Payment  @relation(fields: [payment_id], references: [payment_id], onDelete: Cascade)
  account             Customer @relation(fields: [account_id], references: [cus_id])

  @@index([payment_id], map: "payment_detail_payment_id_fkey")
  @@index([account_id], map: "payment_detail_account_id_fkey")
  @@map("payment_details")
}

model ActivityLog {
  log_id      Int       @id @default(autoincrement())
  branch_id   Int?
  user_id     Int?
  user_name   String?   @db.VarChar(128)
  role        String?   @db.VarChar(50)
  action      String    @db.VarChar(50)
  module      String    @db.VarChar(100)
  entity_id   String?   @db.VarChar(100)
  description String?   @db.Text
  details     Json?
  ip_address  String?   @db.VarChar(64)
  user_agent  String?   @db.VarChar(255)
  created_at  DateTime  @default(now())

  branch      Branch?   @relation(fields: [branch_id], references: [branch_id], onDelete: SetNull)

  @@index([branch_id], map: "activity_logs_branch_id_fkey")
  @@index([user_id], map: "activity_logs_user_id_idx")
  @@index([action], map: "activity_logs_action_idx")
  @@index([module], map: "activity_logs_module_idx")
  @@index([created_at], map: "activity_logs_created_at_idx")
  @@map("activity_logs")
}
