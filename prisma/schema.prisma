enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  CASH
  CHEQUE
  BANK_TRANSFER
  PURCHASE
  CASH_PAYMENT
  BANK_PAYMENT
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  REBATE
  CREDIT
  DEBIT
